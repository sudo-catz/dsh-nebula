{
  "name": "dsh-nebula",
  "version": "1.4.2",
  "type": "module",
  "description": "Nebula: an aurora and a time-aware sky with live weather, a deep-space theme, and a Radio Garden station player for the DeepSeek Harness Web UI.",
  "license": "MIT",
  "author": "sudo-catz",
  "homepage": "https://github.com/sudo-catz/dsh-nebula#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudo-catz/dsh-nebula.git"
  },
  "bugs": {
    "url": "https://github.com/sudo-catz/dsh-nebula/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ambient",
    "theme",
    "sky",
    "aurora",
    "daylight",
    "radio",
    "radio-garden",
    "web-ui",
    "weather",
    "moon",
    "noaa",
    "radio-browser"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/en.json": "./locale/en.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
